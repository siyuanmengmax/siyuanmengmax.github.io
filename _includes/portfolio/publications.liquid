<section class="section" id="publications" aria-labelledby="publications-title">
  <div class="section-head">
    <div>
      <div class="eyebrow">{{ ui.publications.eyebrow }}</div>
      <h2 id="publications-title">{{ ui.publications.title }}</h2>
    </div>
    <div class="pub-controls" role="group" aria-label="{{ ui.publications.filter_label }}">
      {% for filter in ui.publications.filters -%}
        <button
          type="button"
          class="filter{% if forloop.first %} active{% endif %}"
          data-filter="{{ filter.id }}"
          aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}"
        >
          {{ filter.label }}
        </button>
      {%- endfor %}
    </div>
  </div>
  <div class="publication-search">
    <label for="paper-search">{{ ui.publications.search_label }}</label
    ><input id="paper-search" type="search" placeholder="{{ ui.publications.placeholder }}" autocomplete="off"
    ><span id="paper-count" role="status" data-suffix="{{ ui.publications.count_suffix }}">
      {{- site.data.portfolio_publications.size }}
      {{ ui.publications.count_suffix -}}
    </span>
  </div>
  <div id="papers">
    {% for paper in site.data.portfolio_publications %}
      {% assign localized_paper = null %}
      {% if current_lang == 'zh-CN' %}
        {% assign localized_paper = site.data.publications_zh[paper.id] %}
      {% endif %}
      {% assign paper_title = localized_paper.title | default: paper.title %}
      <article class="pub" id="paper-{{ paper.id }}" data-category="{{ paper.category }}">
        <div class="year">{{ paper.year }}</div>
        <div class="pub-copy">
          <h3>{{ paper_title | escape }}</h3>
          <p>
            {% if localized_paper %}
              {% include publication-authors-zh.liquid authors=localized_paper.authors %}
            {% else %}
              {% for author in paper.authors -%}
                {%- if author.self -%}
                  <strong>{{ author.name | escape }}</strong>
                {%- else -%}
                  {{- author.name | escape -}}
                {%- endif -%}
                {%- unless forloop.last %}, {% endunless -%}
              {%- endfor %}
            {% endif %}
          </p>
          <p class="venue">
            {% if localized_paper %}
              {% include publication-venue-zh.liquid venue=localized_paper.venue paper=paper %}
            {% else %}
              {{ paper.venue | escape -}}
              {%- if paper.note != '' %} · {{ paper.note | escape }}{% endif %}
            {% endif %}
          </p>
          <details class="citation">
            <summary>BibTeX</summary>
            <pre>{{ paper.bibtex | escape }}</pre>
          </details>
        </div>
        {% if paper.url -%}
          <a
            class="paper-link"
            href="{{ paper.url | relative_url }}"
            target="_blank"
            rel="noopener"
            aria-label="{{ ui.publications.read }}: {{ paper_title | escape }}"
            >↗</a
          >
        {%- endif %}
      </article>
    {% endfor %}
  </div>
  <p id="no-papers" hidden>{{ ui.publications.empty }}</p>
  <div class="actions">
    <a class="text-link" href="{{ '/assets/portfolio/publications.bib' | relative_url }}" download>{{ ui.publications.download }}</a
    ><a class="text-link" href="https://scholar.google.com/citations?user={{ site.data.socials.scholar_userid }}" target="_blank" rel="noopener"
      >Google Scholar ↗</a
    ><a class="text-link" href="{{ locale_prefix | append: '/publications/' | relative_url }}">{{ ui.publications.archive }}</a>
  </div>
</section>
