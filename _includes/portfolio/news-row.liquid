<div class="news-row">
  <time datetime="{{ include.item.date | date: '%Y-%m-%d' }}">{{ include.item.date | date: '%Y-%m-%d' }}</time>
  <div>
    {% if include.item.inline -%}
      {%- if current_lang == 'zh-CN' and include.item.content_zh -%}
        {{- include.item.content_zh | markdownify | emojify -}}
      {%- else -%}
        {{- include.item.content | markdownify | emojify -}}
      {%- endif -%}
    {%- else -%}
      <a href="{{ include.item.url | relative_url }}">{{ include.item.title }}</a>
    {%- endif %}
  </div>
</div>
