{% if site.favicon_ico %}
  <link rel="icon" type="image/x-icon" sizes="16x16 32x32 48x48" href="{{ site.favicon_ico | relative_url }}">
{% endif %}
{% if site.icon.size <= 4 %}
  <link
    rel="icon"
    href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>{{ site.icon }}</text></svg>"
  >
{% elsif site.icon != blank %}
  <link rel="icon" sizes="any" href="{{ site.icon | prepend: '/assets/img/' | relative_url | bust_file_cache }}">
{% endif %}
{% if site.apple_touch_icon %}
  <link rel="apple-touch-icon" sizes="180x180" href="{{ site.apple_touch_icon | relative_url | bust_file_cache }}">
{% endif %}
