<!doctype html>
{% include locale.liquid %}
{% assign ui = site.data.portfolio[current_lang] %}
{% assign person = site.data.profile.locales[current_lang] %}
{% assign stages = site.data.research_framework[current_lang] %}
{% capture full_name %}{{ site.first_name }} {{ site.last_name }}{% endcapture %}
<html lang="{{ current_lang }}">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>
      {{ full_name | escape }}
      ·
      {{ ui.research.title | escape }}
    </title>
    <meta name="description" content="{{ page.description | default: site.description | strip | escape }}">
    <link rel="canonical" href="{{ page.url | absolute_url }}">
    <link rel="alternate" hreflang="en" href="{{ page.permalink_en | absolute_url }}">
    <link rel="alternate" hreflang="zh-CN" href="{{ page.permalink_zh | absolute_url }}">
    <link rel="alternate" hreflang="x-default" href="{{ page.permalink_en | absolute_url }}">
    <meta property="og:title" content="{{ full_name | escape }}">
    <meta property="og:description" content="{{ ui.hero.intro | escape }}">
    <meta property="og:type" content="website">
    <meta property="og:url" content="{{ page.url | absolute_url }}">
    <meta property="og:image" content="{{ site.data.profile.image | absolute_url }}">
    <meta name="theme-color" content="#f5f5ee">
    {% include favicon.liquid %}
    <link rel="stylesheet" href="{{ '/assets/portfolio/portfolio.css' | relative_url | bust_file_cache }}">
    {% if current_lang == 'zh-CN' %}
      <link rel="stylesheet" href="{{ '/assets/css/chinese-typography.css' | relative_url | bust_file_cache }}">
    {% else %}
      <link rel="preload" href="{{ '/assets/fonts/inter/InterVariable.woff2' | relative_url }}" as="font" type="font/woff2" crossorigin>
      <link rel="stylesheet" href="{{ '/assets/portfolio/english-typography.css' | relative_url | bust_file_cache }}">
    {% endif %}
    <script defer src="{{ '/assets/js/language.js' | relative_url }}"></script>
    <script defer src="{{ '/assets/portfolio/portfolio.js' | relative_url }}"></script>
    <script defer src="{{ '/assets/portfolio/research-demo.js' | relative_url }}"></script>
  </head>
  <body class="{% if current_lang == 'zh-CN' %}zh{% endif %}">
    <a class="skip-link" href="#main">{{ ui.skip }}</a>
    <header>
      <nav class="wrap" aria-label="{{ ui.navigation_label }}">
        <a class="logo" href="{{ locale_prefix | append: '/' | relative_url }}"
          >MAX MENG<span>{{ site.name_zh }}</span></a
        >
        <div class="links">
          {% for link in ui.nav %}
            <a
              href="{{ link.href }}"
              {% if link.href == '#contact' %}
                class="nav-contact"
              {% endif %}
            >
              {{- link.label -}}
            </a>
          {% endfor %}
          <a class="lab-link" href="{{ ui.lab.url }}" title="{{ ui.lab.title }}" target="_blank" rel="noopener">{{ ui.lab.label }}</a>
          {% if current_lang == 'zh-CN' -%}
            {%- assign other_url = page.permalink_en -%}
            {%- assign other_lang = 'en' -%}
          {%- else -%}
            {%- assign other_url = page.permalink_zh -%}
            {%- assign other_lang = 'zh-CN' -%}
          {%- endif %}
          <a
            class="language-switch"
            data-language="{{ other_lang }}"
            href="{{ other_url | relative_url }}"
            lang="{{ other_lang }}"
            hreflang="{{ other_lang }}"
            aria-label="{{ ui.language_accessible }}"
          >
            {{- ui.language_label -}}
          </a>
        </div>
      </nav>
    </header>
    <main class="wrap" id="main">
      <section class="hero" aria-labelledby="hero-title">
        <div>
          <div class="eyebrow availability"><span class="dot"></span>{{ ui.hero.eyebrow }}</div>
          <h1 id="hero-title">{{ ui.hero.title }}</h1>
          <p class="intro">{{ ui.hero.intro }}</p>
          <div class="hero-identity">
            <img src="{{ site.data.profile.image | relative_url }}" width="54" height="66" alt="{{ full_name }}" fetchpriority="high">
            <div>
              <strong>
                {{- full_name }}
                <span lang="zh-CN">{{ site.name_zh }}</span></strong
              >
              <p>{{ person.role }}</p>
              {% if site.data.profile.show_appointment %}
                <p>{{ person.appointment_short }}</p>
              {% endif %}
            </div>
          </div>
          <div class="actions">
            <a class="primary" href="#framework">
              {{- ui.hero.primary }}
              <span class="arrow">↘</span></a
            ><a class="text-link" href="#contact">{{ ui.hero.secondary }}</a>
          </div>
        </div>
        <div class="visual">
          <div class="visual-top">
            <span>{{ ui.scene.title }}</span><span>{{ ui.scene.sensors }}</span>
          </div>
          <canvas id="scene" role="img" aria-label="{{ ui.scene.alt }}"></canvas>
          <div class="visual-bottom">
            <p>
              {{ ui.scene.caption -}}
              <br>
              <span class="scene-disclaimer">{{ ui.scene.disclaimer }}</span>
            </p>
            <button id="pause" type="button" aria-pressed="false" data-pause="{{ ui.scene.pause }}" data-play="{{ ui.scene.play }}">
              {{ ui.scene.pause }}
            </button>
          </div>
        </div>
      </section>
      <div class="affiliation">
        <span
          ><strong>{{ person.affiliation }}</strong> · {{ person.degree -}}
        </span>
        {% if site.data.profile.show_appointment -%}
          <span>{{ person.appointment }}</span>
        {%- endif %}
      </div>
      <section class="section" id="research" aria-labelledby="research-title">
        {% include portfolio/section-heading.liquid section=ui.research id='research-title' %}
        <div class="research-grid">
          {% for direction in ui.research.directions %}
            <article class="research-item">
              <span class="number">{{ direction.number }}</span>
              <h3>{{ direction.title }}</h3>
              <p>{{ direction.description }}</p>
              <div class="tags">
                {% for tag in direction.tags -%}
                  <span>{{ tag }}</span>
                {%- endfor %}
              </div>
            </article>
          {% endfor %}
        </div>
        {% assign vision = ui.research.vision %}
        {% assign vision_paper = site.data.portfolio_publications | where: 'id', vision.paper_key | first %}
        <div class="vision">
          <div>
            <div class="eyebrow">{{ vision.eyebrow }}</div>
            <h3>{{ vision.title }}</h3>
            <p>{{ vision.description }}</p>
            <a class="text-link" href="{{ vision_paper.url }}" target="_blank" rel="noopener">{{ vision.link }}</a>
          </div>
          <div class="vision-note">
            <span>{{ vision.breadth }}</span><strong>{{ vision.motto }}</strong><span>{{ vision.depth }}</span>
          </div>
        </div>
      </section>
      {% include portfolio/framework.liquid %}
      <section class="section" id="projects" aria-labelledby="projects-title">
        {% include portfolio/section-heading.liquid section=ui.projects id='projects-title' %}
        <div class="project-grid">
          {% assign projects = site.projects | where_exp: 'project', "project.category != 'hidden'" | sort: 'path' %}
          {% for project in projects %}
            {% assign project_title = project.title -%}
            {%- assign project_description = project.description -%}
            {%- assign project_url = project.url %}
            {% if current_lang == 'zh-CN' -%}
              {%- assign project_title = project.title_zh | default: project.title -%}
              {%- assign project_description = project.description_zh | default: project.description -%}
              {%- assign project_url = project.permalink_zh | default: project.url -%}
            {%- endif %}
            <article class="project-item">
              <span class="eyebrow">{{ t.categories[project.category] | default: project.category }}</span>
              <h3>{{ project_title }}</h3>
              <p>{{ project_description }}</p>
              <a class="text-link" href="{{ project_url | relative_url }}">{{ ui.projects.details }} ↗</a>
            </article>
          {% endfor %}
        </div>
        <div class="actions">
          <a class="text-link" href="{{ locale_prefix | append: '/projects/' | relative_url }}">{{ ui.projects.archive }}</a>
        </div>
      </section>
      {% include portfolio/publications.liquid %}
      <section class="section" id="about" aria-labelledby="about-title">
        {% include portfolio/section-heading.liquid section=ui.about id='about-title' %}
        <div class="about-grid">
          <div class="about-copy">
            <div class="profile-block">
              <img src="{{ site.data.profile.image | relative_url }}" alt="{{ full_name }}" width="150" height="200" loading="lazy">
              <div>
                <h3>{{ full_name }}</h3>
                <p lang="zh-CN">{{ site.name_zh }}</p>
                <p>{{ person.role }}</p>
              </div>
            </div>
            {% for paragraph in person.bio %}
              <p>{{ paragraph }}</p>
            {% endfor %}
            {% if site.data.profile.show_appointment %}
              <div class="next">
                <div class="eyebrow">{{ ui.about.next }}</div>
                <p>{{ person.appointment }}</p>
              </div>
            {% endif %}
          </div>
          <div class="education">
            {% for degree in person.education %}
              <div class="edu">
                <span>{{ degree.years }}</span><strong>{{ degree.institution }}</strong>
                <p>{{ degree.description }}</p>
              </div>
            {% endfor %}
            <div class="edu">
              <strong>{{ person.teaching_title }}</strong>
              <p>{{ person.teaching }}</p>
              <a class="text-link" href="{{ locale_prefix | append: '/teaching/' | relative_url }}">{{ ui.about.teaching_link }}</a>
            </div>
          </div>
        </div>
        <div class="background-grid">
          {% for block in person.background %}
            <article>
              <div class="eyebrow">{{ block.title }}</div>
              {{ block.html }}
            </article>
          {% endfor %}
        </div>
      </section>
      <section class="section" id="news" aria-labelledby="news-title">
        {% include portfolio/section-heading.liquid section=ui.news id='news-title' %}
        {% assign news = site.news | sort: 'date' | reverse %}
        {% for item in news limit: 4 -%}
          {%- include portfolio/news-row.liquid item=item -%}
        {%- endfor %}
        {% if news.size > 4 %}
          <details class="news-archive">
            <summary>
              {{ ui.news.earlier }}
              <span>+</span>
            </summary>
            {% for item in news offset: 4 -%}
              {%- include portfolio/news-row.liquid item=item -%}
            {%- endfor %}
          </details>
        {% endif %}
        <div class="actions">
          <a class="text-link" href="{{ locale_prefix | append: '/news/' | relative_url }}">{{ ui.news.archive }}</a>
        </div>
      </section>
      <section class="contact" id="contact" aria-labelledby="contact-title">
        <div>
          <div class="eyebrow">{{ ui.contact.eyebrow }}</div>
          <h2 id="contact-title">{{ ui.contact.title }}</h2>
          <p>{{ ui.contact.description }}</p>
          <p>
            <a class="text-link" href="{{ ui.lab.url }}" title="{{ ui.lab.title }}" target="_blank" rel="noopener">{{ ui.lab.call_to_action }}</a>
          </p>
        </div>
        <a class="primary" href="mailto:{{ site.data.socials.email }}">{{ ui.contact.button }}</a>
      </section>
    </main>
    <footer>
      <div class="wrap footer-inner">
        <span
          >© {{ site.time | date: '%Y' }}
          {{ full_name }} · {{ site.name_zh -}}
        </span>
        <div class="social">
          {% if site.data.socials.orcid_id -%}
            <a href="https://orcid.org/{{ site.data.socials.orcid_id }}" target="_blank" rel="noopener">ORCID ↗</a>
          {%- endif %}
          {% if site.data.socials.linkedin_username -%}
            <a href="https://www.linkedin.com/in/{{ site.data.socials.linkedin_username }}/" target="_blank" rel="noopener">LinkedIn ↗</a>
          {%- endif %}
          {% if site.data.socials.github_username -%}
            <a href="https://github.com/{{ site.data.socials.github_username }}" target="_blank" rel="noopener">GitHub ↗</a>
          {%- endif %}
          {% if site.data.socials.research_gate_profile -%}
            <a href="https://www.researchgate.net/profile/{{ site.data.socials.research_gate_profile }}" target="_blank" rel="noopener"
              >ResearchGate ↗</a
            >
          {%- endif %}
          <a href="mailto:{{ site.data.socials.email }}">{{ ui.email }} ↗</a>
        </div>
      </div>
    </footer>
  </body>
</html>
